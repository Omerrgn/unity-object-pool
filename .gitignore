/Library/
/Temp/
/Obj/
/Logs/
/UserSettings/
/Build/
/Builds/
/MemoryCaptures/
/Recordings/

# IDE files Unity regenerates
/*.csproj
/*.sln
/*.slnx
/.vs/
/.vscode/
/.idea/
*.user
*.suo

# Operating system leftovers
Thumbs.db
Desktop.ini
.DS_Store

# Local tool settings
/.claude/settings.local.json
